; Project configuration. Use the Godot editor to edit where possible.
config_version=5

[application]
config/name="Last Night at Camp"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="An original cooperative woodland survival horror prototype."
; Voice writes audio/driver/enable_input here so only voice users open the microphone.
config/project_settings_override="user://engine_overrides.cfg"

[autoload]
Session="*res://scripts/core/session.gd"
Server="*res://scripts/network/server_runtime.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
Net="*res://scripts/network/network_session.gd"
Voice="*res://scripts/network/voice_chat.gd"

[display]
window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]
use_flare={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
recharge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
eat={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
flash_burst={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
map_pin={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.065, 1)
