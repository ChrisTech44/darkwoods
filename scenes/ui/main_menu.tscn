text = "WASD / Arrows  Walk    Shift  Sprint (noisy!)\nE  Use / hold to start or revive    F  Flashlight\nQ  Flare    R  Battery    C  Food    Tab  Notes    Esc  Pause"

[node name="Note" type="Label" parent="ControlsPanel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.7, 0.61, 1)
theme_override_font_sizes/font_size = 7
text = "Cutters: Maintenance. Caches: village / bog / graveyard.\nWolf bursts; Sasquatch hears; moth follows light.\nVampire: aim light. Witch: dodge hex. Revenant: freeze.\nFlares repel all but moth. Bell attracts; stashes are noisy.\nDriver boards on start; others E at van. Solo build."

